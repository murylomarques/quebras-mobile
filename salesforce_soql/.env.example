# Salesforce My Domain da sua organização.
# Exemplo: https://minhaempresa.my.salesforce.com
SALESFORCE_DOMAIN=https://seu-dominio.my.salesforce.com

# Consumer Key e Consumer Secret da External Client App / Connected App.
SALESFORCE_CLIENT_ID=cole-seu-client-id-aqui
SALESFORCE_CLIENT_SECRET=cole-seu-client-secret-aqui

# Opcional. Se omitida, o programa usa v60.0.
SALESFORCE_API_VERSION=v60.0
